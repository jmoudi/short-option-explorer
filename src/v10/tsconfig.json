{
  "//": "Type check gate (build.py runs it; --no-tsc skips): the bundle files in bundle order as global scripts, plus the never-bundled declarations of what the page gets from outside (types/globals.d.ts). Non-strict for now; strict per file as files are converted.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["dom", "es2022"],
    "types": [],
    "skipLibCheck": true
  },
  "files": [
    "types/globals.d.ts",
    "core.js", "adapters.js", "app_store.js", "eng_head.js",
    "dist.js", "inst.js", "rule.js", "pos.js", "cmp.js", "state.js", "ctx.js", "recovery.js", "manage.js", "capture.js",
    "ui_common.js", "ui_summary.js", "ui_dock.js", "ui_facts.js", "ui_capture.js", "ui_views.js", "ui_export.js",
    "compound_engine.js", "compound_stress.js", "compound_ui.js", "app.js"
  ]
}
